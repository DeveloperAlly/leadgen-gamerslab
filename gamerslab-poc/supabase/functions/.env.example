# Edge Function secrets for the GamersLab v1 integration API.
# Set with:  supabase secrets set --env-file supabase/functions/.env  --project-ref ccmwksmgoisijvyovgko
# (Copy to .env and fill in. Never commit real values.)

# Static bearer the web app sends. Generate a long random string; put the SAME value in
# the UI's VITE_API_BEARER. This is the v1 trust boundary (architecture spec §9).
API_BEARER=

# The n8n v10 Discovery webhook (production URL, set once the webhook node is added):
#   https://n8n-j39n.sliplane.app/webhook/<webhookId>
N8N_WEBHOOK_URL=
# Header secret the function sends and the n8n webhook's Header Auth validates.
N8N_WEBHOOK_SECRET=
# Shared secret the n8n workflow sends back to the n8n-status function (x-status-secret).
N8N_STATUS_SECRET=

# Optional: lock CORS to the deployed UI origin (defaults to *).
CORS_ORIGIN=

# ── Email send pipeline (how/email_send_pipeline_DRAFT.md) ───────────────────────
# AES-256-GCM key that encrypts stored refresh tokens. Generate 32 random bytes, base64:
#   openssl rand -base64 32
EMAIL_TOKEN_KEY=
# Where the OAuth callback lives (this project's functions base, no trailing slash):
#   https://ccmwksmgoisijvyovgko.supabase.co/functions/v1
EMAIL_REDIRECT_BASE=
# Where the callback bounces the user back to (the deployed UI origin):
EMAIL_APP_URL=
# Google OAuth app (Google Cloud Console → APIs & Services → Credentials → OAuth client,
# type "Web application"; add EMAIL_REDIRECT_BASE/email-oauth/callback as a redirect URI;
# enable the Gmail API; add scopes gmail.send + gmail.readonly on the consent screen):
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Microsoft OAuth app (Entra ID → App registrations; "Web" platform redirect =
# EMAIL_REDIRECT_BASE/email-oauth/callback; delegated perms Mail.Send + Mail.Read +
# offline_access; create a client secret). Leave MS_TENANT=common for multi-tenant.
MS_CLIENT_ID=
MS_CLIENT_SECRET=
MS_TENANT=common
# The n8n Send workflow webhook (fired by /outreach/:id/approve). The "GamersLab Outreach
# Send" workflow (n8n id YEgPZ0eATTSAb9pa) is already created; activate it, then set:
N8N_SEND_WEBHOOK_URL=https://n8n-j39n.sliplane.app/webhook/gamerslab-send
# n8n auth to the broker uses a CREDENTIAL, not an env var: create a Header Auth credential
# "GamersLab API Bearer" (Name: Authorization, Value: Bearer <API_BEARER>) and bind it to the
# "Get Access Token" node in both the Send and Reply-poll workflows.

# NOTE: SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY are auto-injected into deployed
# Edge Functions of this project — do NOT set them here.

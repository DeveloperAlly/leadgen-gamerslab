# Lead Pipeline UI — backend wiring. Copy to .env.local and fill in.
# Leave VITE_API_BASE blank (or set VITE_USE_FIXTURES=true) to run on local fixtures.

# Edge Functions base (no trailing slash):
VITE_API_BASE=https://ccmwksmgoisijvyovgko.supabase.co/functions/v1
# Must equal the API_BEARER secret set on the Edge Functions:
VITE_API_BEARER=
# Force the fixture backend regardless of API base:
VITE_USE_FIXTURES=false

# Copy to .env and fill in. .env is gitignored — never commit real keys.

# Serper (google.serper.dev) — used by the two Serper HTTP nodes in the workflow.
# Set this same value in your n8n instance environment; the nodes read it via ={{ $env.SERPER_API_KEY }}.
SERPER_API_KEY=your-serper-api-key-here
